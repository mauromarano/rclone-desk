# Copy this file to .env and adjust values as needed.

# Host port exposed by Docker Compose.
PORT=8000

# Host address to bind. Use 0.0.0.0 to expose on all interfaces, including LAN.
BIND_ADDRESS=127.0.0.1

# Timezone used by the container (IANA name, for example Europe/Rome).
TZ=UTC

# Host directory used to persist application data.
RCLONE_DESK_DATA_DIR=./data

# Hostnames and browser origins allowed by the application.
APP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
APP_ALLOWED_ORIGINS=
